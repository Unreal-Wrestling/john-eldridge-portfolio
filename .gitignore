*.mp4
# Project videos are deliberate portfolio assets, small and web-ready.
# The blanket ignore above is for the large source masters in the root.
!projects/**/*.mp4

# Generated by build.py - never commit build output
dist/

# Wrangler local cache - contains account metadata
.wrangler/

# Local contact sheets for reviewing shoot archives - scratch, not assets
.review/

# Node - wrangler is pinned in package.json and installed with 'npm install'.
# node_modules holds a ~97 MB workerd.exe and must never be committed.
node_modules/

# Python
__pycache__/
*.pyc
